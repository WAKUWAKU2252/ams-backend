{
  "name": "ams-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import:department": "bun run src/intrastucture/db/import/department.ts",
    "db:import:employee": "bun run src/intrastucture/db/import/employee.ts",
    "db:import:employee-ubp": "bun run src/intrastucture/db/import/employee-ubp.ts",
    "db:import:location": "bun run src/intrastucture/db/import/location.ts",
    "db:import:role": "bun run src/intrastucture/db/import/role.ts",
    "db:import:user": "bun run src/intrastucture/db/import/user.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/bun": "latest",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.20.4",
    "daisyui": "^5.7.16",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "mssql": "^12.7.0",
    "pg": "^8.22.0"
  }
}
