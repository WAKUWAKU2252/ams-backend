# ===== AMS Elysia Server =====
# วิธีใช้: copy ไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องตัวเอง
#   cp .env.example .env
# ทุก key ต้องตรงกับ schema ใน src/config/env.ts — เพิ่ม/ลบ key ให้อัปเดตทั้งสองไฟล์คู่กันเสมอ

# Server
PORT=3000

# PostgreSQL (Docker container ของ AMS)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ams_db
# local ปล่อย false — เปลี่ยนเป็น true ตอนต่อ DB บน server จริงที่บังคับ SSL
DB_SSL=false

# CORS — origin ของ Vue dev server (Vite)
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# JWT — secret ต้องยาว >=16 ตัว, server จริงให้ gen สุ่ม (openssl rand -hex 32) เก็บใน secret manager
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h