# ===== AMS Elysia Server =====
# วิธีใช้: copy ไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องตัวเอง
#   cp .env.example .env
# ทุก key ต้องตรงกับ schema ใน src/config/env.ts — เพิ่ม/ลบ key ให้อัปเดตทั้งสองไฟล์คู่กันเสมอ
#
# ⚠️ ไฟล์นี้อยู่ใน git (ต่างจาก .env ที่ถูก ignore) — ห้ามใส่ค่าจริงเด็ดขาด
# host / user / password / secret ทุกตัวในนี้ต้องเป็น placeholder เท่านั้น
# ใครเผลอใส่ของจริงแล้ว commit = รหัสหลุดถาวรใน history ต่อให้ลบทีหลังก็ยังอ่านย้อนได้

# Server
PORT=3000

# ===== PostgreSQL (ams_db — DB หลักของ AMS ที่เราเป็นเจ้าของ) =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ams_db
DB_SSL=false

# CORS — origin ของ Vue dev server (Vite)
CORS_ORIGIN=http://localhost:5173
# โดเมนของหน้าเว็บ — ใช้ประกอบ URL ที่ฝังใน QR ของสติกเกอร์สินทรัพย์
# ⚠️ ตั้งเป็นโดเมนจริงก่อนพิมพ์สติกเกอร์ล็อตแรก เปลี่ยนทีหลัง = ต้องพิมพ์ใหม่ทุกชิ้น
APP_BASE_URL=http://localhost:5173
# ⚠️ production ใช้ absolute path และต้องเป็น volume ที่ไม่หายตอน redeploy
UPLOAD_DIR=./uploads
# กวาดไฟล์กำพร้าทุกกี่นาที — 0 = ปิด (เครื่อง dev ที่แชร์ DB กันควรปิด)
UPLOAD_CLEANUP_INTERVAL_MINUTES=60

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ===== Power Automate (แจ้งขออนุมัติเข้า Teams) =====
# ⚠️ URL จริงมี ?sig=... ต่อท้าย ซึ่งเป็นความลับเทียบเท่ารหัสผ่าน — ห้ามใส่ของจริงในไฟล์นี้
#    ใครถือ sig ยิง POST เข้า flow ได้ตรง ๆ = ส่งการ์ดขออนุมัติปลอมเข้า Teams ของหัวหน้าได้
#    ไม่จำกัดจำนวน และเรียกคืนไม่ได้
# เว้นว่างได้: เครื่องที่ยังไม่ได้ต่อ Teams จะสตาร์ทได้ปกติ แต่เส้นที่ต้องใช้จะตอบ 503
# — ขาออก: การ์ดขออนุมัติไปหาหัวหน้า
POWER_AUTOMATE_URL=
# — ขาออก: แจ้งผลกลับผู้ขอ (คนละ flow กัน)
POWER_AUTOMATE_REQUESTER_URL=

# shared secret ของ **ขาเข้า** POST /teams/webhook — คนละทิศกับสอง URL ข้างบน
#
# ⚠️ เส้นนั้นไม่มี JWT (Power Automate ไม่มี token ของเรา) ค่านี้จึงเป็นด่านเดียวที่กันอยู่
#    ใครถือค่านี้ + รู้ URL ของ AMS = curl บรรทัดเดียวอนุมัติ/ปฏิเสธใบคำขอได้
#    (ยังต้องส่ง approvedBy ที่เป็น employee ซึ่งมี user role อนุมัติได้ — แต่แค่นั้น
#     ไม่ได้ตรวจว่าเป็นหัวหน้าของแผนกในใบนั้นจริงมั้ย)
# เว้นว่าง = ปิดเส้นนั้นทิ้ง (503) ไม่ใช่ปล่อยผ่าน — ตั้งใจให้ fail closed
TEAMS_WEBHOOK_SECRET=

SAP_DB_HOST=10.0.0.1
SAP_DB_PORT=1433
# ฐานเริ่มต้นตอน connect — ชื่อฐานรายบริษัทของจริงอ่านจาก company.sapDbName ใน ams_db
SAP_DB_NAME=your_sap_database
SAP_DB_USERNAME=your_sap_readonly_user
SAP_DB_PASSWORD=your_sap_password
SAP_DB_ENCRYPT=true
SAP_DB_TRUST_CERT=true
SAP_READ_UNCOMMITTED=true

# ===== ตั้งค่า sync =====
SAP_ITEM_GROUPS=117
SAP_BACKFILL_WINDOW_DAYS=180
# 0 = ปิด scheduler ข้อมูลจะรีเฟรชเมื่อมีคนกดปุ่ม Sync เท่านั้น
SAP_SYNC_INTERVAL_MINUTES=120
# เวลาหน่วงระหว่างการกดปุ่ม Sync ของบริษัทเดียวกัน (ใช้ร่วมกันทุกคน ไม่ใช่ราย user)
SAP_SYNC_COOLDOWN_SECONDS=300